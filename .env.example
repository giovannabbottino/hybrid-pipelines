# Ollama: the selected model must support native tool calling.
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_SEED=42
OLLAMA_TEMPERATURE=0
OLLAMA_TOP_K=1
OLLAMA_TOP_P=1
OLLAMA_MIN_P=0
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192
OLLAMA_JSONL_PATH=logs/ollama_responses.jsonl

# NED with MCP, followed by RDF generation.
ANALYZE_TIMEOUT_SECONDS=540
ANALYZE_LOG_PATH=logs/analyze_log.jsonl
SYSTEM_PROMPT_NAME=system/agent.txt
NED_PROMPT_NAME=prompts/ned.txt
RDF_BUILD_PROMPT_NAME=prompts/rdf-build.txt
MCP_MAX_TURNS=20
MCP_MAX_TOOL_CALLS=40

# Discover these tools from the MCP server; the LLM chooses when to call them.
WIKIDATA_MCP_URL=https://wd-mcp.wmcloud.org/mcp/
WIKIDATA_TIMEOUT_SECONDS=60
WIKIDATA_MCP_TOOLS=search_items,get_statements
