@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #375A7F
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam activityBackgroundColor #EAF1F8
skinparam activityBorderColor #375A7F
skinparam activityDiamondBackgroundColor #FFF3D6
title Hybrid pipelines: text to RDF
start
:POST /analyze\nValidate request and normalize text;
:LLM extracts mentions\nStrictly parse, realign, supplement and deduplicate;
:Search Wikidata candidates for each mention\nFetch statements for every candidate;
:Build bounded cross-mention paths up to two hops\nExclude high-degree intermediate nodes;
:LLM selects one supplied QID per non-empty group\nRetry pending groups up to three attempts\nFail with HTTP 422 if unresolved;
:Retain direct relationships among selected entities;
:Build RDF prompt with text and selected evidence;
repeat
  :Ollama returns triples JSON\nConstrain output with RDF_TRIPLES_SCHEMA;
  :Validate fields, identifiers and literal metadata\nNormalize kg names\nBuild RDFLib graph and serialize Turtle;
  :Parse Turtle and check graph postconditions;
  if (Valid graph?) then (yes)
    :Apply Wikidata-ID and label postconditions\nSerialize and validate Turtle again;
:Return HTTP 200 with Turtle string\nWrite configured request and generation logs;
    stop
  else (no)
    :Record validation error;
  endif
repeat while (Attempts remain? max_rdf_attempts = 1 to 3) is (yes: feedback to same RDF stage) not (no)
:Return HTTP 422 with validation details;
stop
@enduml
